# Accordio tracker - environment variables
# Copy to .env and fill in your values

# ============================================
# Error Monitoring (Optional, recommended for production)
# ============================================
# Get your Sentry DSN from https://sentry.io
SENTRY_DSN=

# Set to true to enable Sentry in development mode
# SENTRY_DEBUG=true

# ============================================
# Apple Notarization (Required for production macOS builds)
# ============================================
# Your Apple Developer account email
APPLE_ID=
# Generate at https://appleid.apple.com → Sign-In and Security → App-Specific Passwords
APPLE_APP_SPECIFIC_PASSWORD=
# Your Apple Developer Team ID (visible at https://developer.apple.com/account)
APPLE_TEAM_ID=

# Optional: set to true/1 to skip notarization for local packaging checks
# SKIP_NOTARIZE=true
