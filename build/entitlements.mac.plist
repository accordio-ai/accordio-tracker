<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Electron's V8 JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for Electron's renderer process -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Network access for API calls and WebSocket gateway -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Required for loading native modules (active-win, file-icon) not signed by same team -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Required for active-win to query window information on newer macOS -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
